{
  "name": "hire_ai_v2",
  "version": "1.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "tsx watch server/_core/index.ts",
    "build": "vite build && node scripts/check-production-bundle.mjs && esbuild server/_core/index.ts --platform=node --packages=external --external:./vite --bundle --format=esm --outdir=dist && esbuild scripts/database-schema-audit.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/database-schema-audit.js && esbuild scripts/database-query-plan-audit.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/database-query-plan-audit.js",
    "start": "node dist/index.js",
    "start:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows.ps1",
    "start:ngrok": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-ngrok.ps1",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:database": "node scripts/run-database-acceptance.mjs",
    "doctor": "node scripts/doctor.mjs",
    "security:audit": "pnpm audit --audit-level moderate",
    "db:backup": "node scripts/database-backup.mjs",
    "db:backup:verify": "node scripts/database-backup.mjs verify",
    "db:restore": "node scripts/database-restore.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/database-migrate.mjs",
    "db:audit-schema": "node dist/database-schema-audit.js",
    "db:audit-query-plans": "node dist/database-query-plan-audit.js",
    "db:push": "node scripts/database-migrate.mjs"
  },
