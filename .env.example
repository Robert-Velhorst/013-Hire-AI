# Core runtime
NODE_ENV=development
PORT=3000
# Loopback is the secure Windows default. Docker sets 0.0.0.0 explicitly.
HOST=127.0.0.1
DATABASE_URL=mysql://user:password@localhost:3306/hire_ai
DB_MIGRATION_CONNECT_TIMEOUT_MS=15000
DB_MIGRATION_LOCK_WAIT_SECONDS=60
JWT_SECRET=replace-with-a-long-random-secret
# The worker only runs for users who explicitly enabled scheduled background runs.
# Set to false to disable it instance-wide for maintenance.
AUTONOMOUS_SCHEDULER_ENABLED=true
JOB_SCRAPING_SCHEDULER_ENABLED=false
JOB_SCRAPING_INTERVAL_MINUTES=60
JOB_SCRAPING_MAX_JOBS_PER_RUN=100
JOB_SCRAPING_SOURCE_TIMEOUT_MS=90000
JOB_SCRAPING_MAX_CONCURRENT_SOURCES=3
# Optional comma-separated platform names. Leave blank to use every active configured source.
JOB_SCRAPING_ENABLED_PLATFORMS=

# Optional local/private HAI A2A connector. It is disabled by default and
# exposes only aggregate status for one numeric Hire.AI user ID.
HAI_CONNECTOR_ENABLED=false
HAI_CONNECTOR_TOKEN=
HAI_CONNECTOR_USER_ID=
HAI_CONNECTOR_URL=http://127.0.0.1:3000/api/hai/a2a

# Sensitive documents are rejected in production until this malware-scanner endpoint is configured.
FILE_MALWARE_SCAN_URL=

# Manus OAuth / Forge runtime
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=http://localhost:3000

# Connector OAuth - configure only the providers you explicitly enable.
CONNECTOR_OAUTH_REDIRECT_URI=
CONNECTOR_TOKEN_ENCRYPTION_KEY=
CONNECTOR_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# AWS S3 document storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
